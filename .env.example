# Copy this file to .env in the TRACE repository root. Never commit your real key.
SARVAM_API_KEY=
# Best generally available reasoning option in Sarvam's catalog, checked 2026-10-31.
# Use sarvam-105b for Sarvam's own multilingual model, or glm5.3-flash for lower cost.
SARVAM_MODEL=glm5.3
SARVAM_REASONING_EFFORT=high
SARVAM_MAX_TOKENS=8192
SARVAM_TIMEOUT_SECONDS=120
# Hard local request/token reservations per UTC day; includes retries and reasoning budget.
SARVAM_DAILY_REQUEST_LIMIT=50
SARVAM_DAILY_TOKEN_LIMIT=500000
# Optional bearer token to protect the API when shared. Server defaults to localhost.
TRACE_API_TOKEN=

# Keep local for the default demo; Neo4j is optional and requires graph-sync.
# Optional graph database: install pip install -e ".[graph]"
TRACE_GRAPH_BACKEND=local
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
